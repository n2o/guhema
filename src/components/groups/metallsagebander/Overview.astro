---
import Base from '../../../layouts/Base.astro';
import BladeImage from '../../products/BladeImage.astro';
import GroupHeader from '../../products/GroupHeader.astro';
import { bladesOfGroup, changed, detailPath, type ProductGroup } from '../../../lib/data';
import { t, tr, url, type Lang } from '../../../lib/i18n';
import { markdown } from '../../../lib/markdown';

interface Props { lang: Lang; group: ProductGroup }
const { lang, group } = Astro.props;
const blades = bladesOfGroup(group);
const headings = blades.map((b) => tr(b.heading, lang));
const headingChanged = changed(headings);
---
<Base lang={lang}>
  <h1 slot="heading">
    {tr(group.name, lang)}
  </h1>

  <GroupHeader lang={lang} group={group} />

  {blades.map((blade, i) => {
    const details = url(lang, detailPath(group, blade));
    return (<>
      {headingChanged[i] && <h3 class="padding-bottom">{headings[i]}</h3>}

      <div class="blade-row">
        <div class="row">
          <BladeImage lang={lang} image={tr(blade.image, lang)} href={details} alias="blade_image_250h" alt={blade.quality} wrap="col-md-6" />
          <BladeImage lang={lang} image={tr(blade.image2, lang)} href={details} alias="blade_image_250h" alt={blade.quality} wrap="col-md-6" />
        </div>

        <div class="row">
          <div class="col-md-6">
            <div class="spec-line">
              <img src="/static/img/other/shark_small_45w.png" alt="">
              <a href={details}>{blade.quality}</a>
            </div>
            <div class="spec-line">
              <img src="/static/img/other/blade_small_45w.png" alt="">
              <span>{tr(blade.name, lang)}</span>
            </div>
            <div class="spec-line">
              <img src="/static/img/other/tool_small_45w.png" alt="">
              <div set:html={markdown(tr(blade.description, lang))} />
            </div>
          </div>
          <div class="col-md-6">
            <p>
              <span class="text-orange-bold">{blade.type}...</span> = {tr(blade.type_description, lang)}<br>
              <span class="text-orange-bold">{blade.type2}...</span> = {tr(blade.type2_description, lang)}
            </p>
            <p>
              <a href={details}>
                {t(lang, 'Details')}
              </a>
            </p>
          </div>
        </div>
      </div>
    </>);
  })}
</Base>
