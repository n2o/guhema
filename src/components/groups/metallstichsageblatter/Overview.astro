---
import Base from '../../../layouts/Base.astro';
import GroupHeader from '../../products/GroupHeader.astro';
import GeneralAdviceSawblades from '../../products/GeneralAdviceSawblades.astro';
import Thumb from '../../Thumb.astro';
import { bladesOfGroup, detailPath, type ProductGroup } from '../../../lib/data';
import { t, tr, url, type Lang } from '../../../lib/i18n';

interface Props { lang: Lang; group: ProductGroup }
const { lang, group } = Astro.props;
const blades = bladesOfGroup(group);
const columns = [['ISD', 'ISE'], ['ISF']];
---
<Base lang={lang}>
  <h1 slot="heading">
    {tr(group.name, lang)}
  </h1>

  <GroupHeader lang={lang} group={group} />

  <GeneralAdviceSawblades lang={lang} noToothforms />

  <hr>

  <h3 class="padding-bottom">{t(lang, "Produkte")}</h3>
  <div class="row">
    {columns.map((types) => (
      <div class="col-md-6">
        {blades.filter((blade) => types.includes(blade.type)).map((blade) => {
          const href = url(lang, detailPath(group, blade));
          return (
            <>
              {blade.image && (
                <div class="clamping-img">
                  <Thumb path={tr(blade.image, lang)} alias="blade_image" alt={`${blade.quality} ${blade.type}`} />
                </div>
              )}

              <div class="products-list-item">
                <div class="spec-line">
                  <img src="/static/img/other/shark_small_45w.png" alt="">
                  <a href={href}>{blade.quality}</a>
                </div>
                <div class="spec-line">
                  <img src="/static/img/other/blade_small_45w.png" alt="">
                  <span>
                    {tr(blade.description, lang)}<br>
                    <a href={href}>
                      <span class="text-orange-bold">{blade.type}</span> {t(lang, "Details")}
                    </a>
                  </span>
                </div>
              </div>
            </>
          );
        })}
      </div>
    ))}
  </div>
</Base>
