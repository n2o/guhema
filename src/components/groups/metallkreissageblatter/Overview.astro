---
import Base from '../../../layouts/Base.astro';
import GroupHeader from '../../products/GroupHeader.astro';
import { bladesOfGroup, changed, circularIndicators, sortBy, type ProductGroup } from '../../../lib/data';
import { float, t, tr, type Lang } from '../../../lib/i18n';

interface Props { lang: Lang; group: ProductGroup }
const { lang, group } = Astro.props;
const blades = bladesOfGroup(group);
const [blade] = blades;
const other = sortBy(circularIndicators, (i) => i.diameter);
const diameterChanged = changed(other.map((ind) => ind.diameter));
// Kennziffer 2 columns: [tooth form, tooth pitch in mm]; the indicator field is e.g. BW_3
const columns = [['BW', 3], ['BW', 4], ['HZ', 5], ['HZ', 6], ['BW', 7], ['HZ', 8], ['HZ', 9], ['HZ', 10], ['HZ', 12], ['HZ', 14]] as const;
const num1 = '1.3343';
const num2 = '1.3243';
---
<Base lang={lang}>
  <h1 slot="heading">
    {tr(group.name, lang)}
  </h1>

  <GroupHeader lang={lang} group={group} />

  <div>
    <h3>{t(lang, 'Material, Qualitäten und Einsatzbereiche')}</h3>
    <p>
      {t(lang, 'Nachfolgend sind unsere zwei Qualitäten aus Schnellarbeitsstahl aufgeführt:')}
    </p>

    <div class="well">
      <div class="spec-line"><img src="/static/img/other/shark_small_45w.png" alt="">
        <span>GUHEMA Super-HSS</span>
      </div>
      <div class="spec-line"><img src="/static/img/other/blade_small_45w.png" alt="">
        <span>{t(lang, 'DMo 5 Qualität (Werkstoff-Nr. %(num)s)', { num: num1 })}</span>
      </div>
      <div class="spec-line"><img src="/static/img/other/tool_small_45w.png" alt="">
        <span>{t(lang, 'Das Werkstattblatt')}</span>
      </div>

      <div class="padding-top-05">
        <div class="spec-line"><img src="/static/img/other/shark_small_45w.png" alt="">
        <span>GUHEMA Brillant</span>
      </div>
        <div class="spec-line"><img src="/static/img/other/blade_small_45w.png" alt="">
        <span>{t(lang, 'EMo 5 Co 5 Qualität (Werkstoff-Nr. %(num)s)', { num: num2 })}</span>
      </div>
        <div class="spec-line"><img src="/static/img/other/tool_small_45w.png" alt="">
        <span>{t(lang, 'Für nicht rostende Stähle')}</span>
      </div>
      </div>
    </div>

    <h3>{t(lang, 'Fühlen Sie uns auf den Zahn')}</h3>
    <p>
      {t(lang, 'Wenn perfektes Trennen angestrebt ist, müssen alle Faktoren optimal aufeinander abgestimmt sein. Die Zahnform spielt dabei eine bedeutungsvolle Rolle. Ihnen stehen folgende Zahnformen zur Verfügung, die nach DIN 1840 gefertigt werden:')}
    </p>

    <div class="row stack-gap">
      <div class="col-md-6">
        <h4>{t(lang, 'Bogenzahn mit Wechselschliff')} (BW)</h4>
        <p>
          {t(lang, 'Wir empfehlen den Bogenzahn mit Wechselschliff bei Metallkreissägeblättern bei einer feinen Zahnteilung zum Sägen von Rohren oder Profilen.')}
        </p>
      </div>
      <div class="col-md-6">
        <h4>{t(lang, 'Bogenzahn mit Vor- und Nachschneider')} (HZ)</h4>
        <p>
          {t(lang, 'Der Bogenzahn mit Vor- und Nachschneider ist für das Sägen von Stählen auf Sägemaschinen und Rundtaktautomaten geeignet und empfiehlt sich bei mittleren und groben Zahnteilungen.')}
        </p>
      </div>
    </div>

  </div>

  <hr>

  <h3 class="padding-bottom">{t(lang, 'Produkte')}</h3>

  <div class="row padding-bottom">
    {blades.map((b) => (
      <div class="col-md-4">
        <div class="spec-line">
          <img src="/static/img/other/shark_small_45w.png" alt="">
          <span>{b.quality} <span class="text-orange-bold">{b.type}...</span></span>
        </div>
        <div class="spec-line">
          <img src="/static/img/other/blade_small_45w.png" alt="">
          <span>{tr(b.name, lang)}</span>
        </div>
        <div class="spec-line">
          <img src="/static/img/other/tool_small_45w.png" alt="">
          <span>{tr(b.description, lang)}</span>
        </div>
      </div>
    ))}

    <div class="col-md-4">
      <p class="alert bg-orange-lighter">
        {t(lang, 'Der schnelle Weg zu unserer Artikel-Nr.')}<br>
        <span class="text-orange-bold">{t(lang, 'Qualität')}</span> + <span
          class="text-orange-bold">{t(lang, 'Kennziffer')} 1</span> + <span
          class="text-orange-bold">{t(lang, 'Kennziffer')} 2</span> + <span
          class="text-orange-bold">{t(lang, 'Kennziffer')} 3</span><br>
        {t(lang, 'z.B.:')}
        <span class="text-orange-bold">{blade.type}</span> + <span
          class="text-orange-bold">{other[0].value}</span> + <span class="text-orange-bold">G</span> + <span
          class="text-orange-bold">BH</span> = <span
          class="text-orange-bold">{blade.type}{other[0].value}GBH</span>
      </p>
    </div>
  </div>

  <div class="table-responsive">
  <table id="products-sawblade-table" class="table table-condensed table-striped-column table-hover">
    <thead>
    <tr>
      <th colspan="3" class="table-white-border-right table-no-bot-border">&Oslash; / {t(lang, 'Stärke')}{' '}/ {t(lang, 'Bohrung')}</th>
      <th class="table-white-border-right table-no-bot-border">{t(lang, 'Kennziffer')} 1</th>
      {columns.map(([form]) => <th class="table-no-bot-border">{form}</th>)}
      <th class="table-no-bot-border">NL</th>
    </tr>
    <tr>
      <th colspan="3" class="table-white-border-right table-no-top-border">{t(lang, 'in mm')}</th>
      <th class="table-white-border-right table-no-top-border"></th>
      {columns.map(([, mm]) => <th class="table-no-top-border">{mm} {t(lang, 'mm')}</th>)}
      <th class="table-no-top-border">in {t(lang, 'mm')}</th>
    </tr>
    </thead>
    <tbody>
    {other.map((ind, i) => (
      <tr>
        <td>
          {diameterChanged[i] && ind.diameter}
        </td>
        <td>
          {float(lang, ind.strength)}
        </td>
        <td class="table-white-border-right">
          {ind.bore}
        </td>
        <td class="text-orange-bold table-white-border-right">
          ...{ind.value}...
        </td>
        {columns.map(([form, mm]) => {
          const value = ind[`${form}_${mm}`];
          return <td>{value !== 0 ? value : ''}</td>;
        })}
        <td>{ind.NL}</td>
      </tr>
    ))}
    </tbody>
  </table>
  </div>

  <div class="row">
      <div class="col-md-5">
        <h4 class="legend-heading">{t(lang, 'Kennziffer')} 2 <small>{t(lang, 'Legende')} {t(lang, 'Zähnezahl')}</small></h4>
        <div class="table-responsive">
        <table class="table table-condensed table-striped-column table-hover">
          <thead>
          <tr>
            <th>BW</th>
            <th colspan="3">HZ</th>
          </tr>
          </thead>
          <tbody>
          <tr>
            <td>160 = <span class="text-orange-bold">...Q...</span></td>
            <td>72 = <span class="text-orange-bold">...A...</span></td>
            <td>120 = <span class="text-orange-bold">...H...</span></td>
            <td>200 = <span class="text-orange-bold">...O...</span></td>
          </tr>
          <tr>
            <td>180 = <span class="text-orange-bold">...R...</span></td>
            <td>80 = <span class="text-orange-bold">...B...</span></td>
            <td>128 = <span class="text-orange-bold">...I...</span></td>
            <td>220 = <span class="text-orange-bold">...P...</span></td>
          </tr>
          <tr>
            <td>200 = <span class="text-orange-bold">...S...</span></td>
            <td>84 = <span class="text-orange-bold">...C...</span></td>
            <td>140 = <span class="text-orange-bold">...J...</span></td>
            <td>270 = <span class="text-orange-bold">...Ü...</span></td>
          </tr>
          <tr>
            <td>220 = <span class="text-orange-bold">...U...</span></td>
            <td>90 = <span class="text-orange-bold">...D...</span></td>
            <td>144 = <span class="text-orange-bold">...K...</span></td>
            <td>280 = <span class="text-orange-bold">...X...</span></td>
          </tr>
          <tr>
            <td>240 = <span class="text-orange-bold">...V...</span></td>
            <td>96 = <span class="text-orange-bold">...E...</span></td>
            <td>150 = <span class="text-orange-bold">...L...</span></td>
            <td>300 = <span class="text-orange-bold">...Y...</span></td>
          </tr>
          <tr>
            <td>250 = <span class="text-orange-bold">...W...</span></td>
            <td>100 = <span class="text-orange-bold">...F...</span></td>
            <td>160 = <span class="text-orange-bold">...M...</span></td>
            <td>340 = <span class="text-orange-bold">...Z...</span></td>
          </tr>
          <tr>
            <td>280 = <span class="text-orange-bold">...X...</span></td>
            <td>110 = <span class="text-orange-bold">...G...</span></td>
            <td>180 = <span class="text-orange-bold">...N...</span></td>
            <td></td>
          </tr>
          </tbody>
        </table>
        </div>
      </div>
      <div class="col-md-offset-1 col-md-3">
        <h4 class="legend-heading">{t(lang, 'Kennziffer')} 3 <small>{t(lang, 'Legende')} {t(lang, 'Nebenlöcher')}</small></h4>

        <div class="table-responsive">
        <table class="table table-condensed table-striped-column table-hover legend-table">
          <tbody>
          <tr>
            <td>2/8/45 = <span class="text-orange-bold">...A...</span></td>
          </tr>
          <tr>
            <td>2/8/55 = <span class="text-orange-bold">...B...</span></td>
          </tr>
          <tr>
            <td>2/9/50 = <span class="text-orange-bold">...C...</span></td>
          </tr>
          <tr>
            <td>2/11/63 = <span class="text-orange-bold">...D...</span></td>
          </tr>
          <tr>
            <td>2/12/64 = <span class="text-orange-bold">...E...</span></td>
          </tr>
          <tr>
            <td>2/15/80 = <span class="text-orange-bold">...F...</span></td>
          </tr>
          <tr>
            <td>4/9/50 = <span class="text-orange-bold">...G...</span></td>
          </tr>
          <tr>
            <td>4/12/64 = <span class="text-orange-bold">...H...</span></td>
          </tr>
          <tr>
            <td>4/15/80 = <span class="text-orange-bold">...I...</span></td>
          </tr>
          </tbody>
        </table>
        </div>
      </div>
    </div>

  <div class="row">
      <div class="col-md-6">
        <img class="img-responsive"
             src="/static/img/produktbilder/metallkreissaegen/metallkreissaege_schema.png"
             alt={t(lang, 'Metallkreissäge')}>
      </div>
      <div class="col-md-6">
        <h3>{t(lang, 'Bei der Bestellung machen Sie bitte folgende Angaben:')}</h3>
        <ul>
          <li>{t(lang, 'Artikelnummer')}</li>
          <li>{t(lang, 'Andere Abmessungen bieten wir an, nennen Sie uns:')}
          <ul>
            <li><strong>A</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Durchmesser des Blattes')}</li>
            <li><strong>B</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Blattstärke')}</li>
            <li><strong>C</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Hauptbohrung')}</li>
            <li><strong>D</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Anzahl der Nebenlöcher')}</li>
            <li><strong>E</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Lochdurchmesser')}</li>
            <li><strong>F</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Teilkreis der Nebenlöcher')}</li>
            <li><strong>G</strong>&nbsp;&nbsp;&nbsp;{t(lang, 'Zahnteilung oder Zähnezahl')}</li>
          </ul>
          </li>
        </ul>
      </div>
    </div>
</Base>
