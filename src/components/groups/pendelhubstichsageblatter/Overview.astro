---
// Former products/pendelhubstichsageblatter/overview.html
import Base from '../../../layouts/Base.astro';
import BladeImage from '../../products/BladeImage.astro';
import GroupHeader from '../../products/GroupHeader.astro';
import { bladesOfGroup, changed, type ProductGroup } from '../../../lib/data';
import { float, t, tr, type Lang } from '../../../lib/i18n';
import { markdown } from '../../../lib/markdown';

interface Props {
  lang: Lang;
  group: ProductGroup;
}
const { lang, group } = Astro.props;
const blades = bladesOfGroup(group);
const subcategories = blades.map((blade) => tr(blade.subcategory, lang));
const subcategoryChanged = changed(subcategories);
---
<Base lang={lang}>
  <h1 slot="heading">{tr(group.name, lang)}</h1>

  <GroupHeader lang={lang} group={group} />

  {blades.map((blade, i) => (
    <>
      {/* ifchanged blade.subcategory */}
      {subcategoryChanged[i] && <h3 class="padding-bottom">{subcategories[i]}</h3>}

      <div class="blade-row">
        <BladeImage lang={lang} image={tr(blade.image, lang)} alias="blade_image_250h" alt={blade.type} />

        <div class="row">
          <div class="col-md-6">
            <div class="spec-line">
              <img src="/static/img/other/shark_small_45w.png" alt="">
              <span>{blade.quality}</span>
            </div>
            <div class="spec-line">
              <img src="/static/img/other/tool_small_45w.png" alt="">
              <div set:html={markdown(tr(blade.description, lang))} />
            </div>
          </div>
          <div class="col-md-6">
            <div class="table-responsive">
              <table class="table table-condensed table-striped-column table-hover">
                <thead>
                <tr>
                <th>
                  {t(lang, 'Bestell-Nr.')}
                </th>
                <th>
                  {t(lang, 'Zahnteilung')}
                </th>
                <th>
                  {t(lang, 'Sägeblattlänge')}
                </th>
                {blade.cutting_metal && (
                  <th>
                    {t(lang, 'Schnittbereich Metall')}
                  </th>
                )}
                {blade.cutting_wood && (
                  <th>
                    {t(lang, 'Schnittbereich Holz')}
                  </th>
                )}
                </tr>
                </thead>
                <tbody>
                <tr>
                  <td class="text-orange-bold">
                    {blade.type}
                  </td>
                  <td>
                    {float(lang, blade.tooth_separation)} {t(lang, 'ZpZ')}
                  </td>
                  <td>
                    {blade.length} {t(lang, 'mm')}
                  </td>
                  {blade.cutting_metal && (
                    <td>
                      {blade.cutting_metal} {t(lang, 'mm')}
                    </td>
                  )}
                  {blade.cutting_wood && (
                    <td>
                      {blade.cutting_wood} {t(lang, 'mm')}
                    </td>
                  )}
                </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </>
  ))}
</Base>
