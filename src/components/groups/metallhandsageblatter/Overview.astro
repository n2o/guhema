---
import Base from '../../../layouts/Base.astro';
import GroupHeader from '../../products/GroupHeader.astro';
import BladeImage from '../../products/BladeImage.astro';
import { bladesOfGroup, changed, indicatorsOf, type ProductGroup } from '../../../lib/data';
import { t, tr, float, type Lang } from '../../../lib/i18n';
import { markdown } from '../../../lib/markdown';

interface Props { lang: Lang; group: ProductGroup }
const { lang, group } = Astro.props;
const blades = bladesOfGroup(group);
// Accessories and ASM rows get no block of their own; ifchanged only sees the rows that are rendered
const rows = blades.flatMap((blade, i) => (blade.accessory || blade.type === 'ASM' ? [] : [{ blade, i, subcategory: tr(blade.subcategory, lang) }]));
const subcategoryChanged = changed(rows.map((row) => row.subcategory));
---
<Base lang={lang}>
  <h1 slot="heading">
    {tr(group.name, lang)}
  </h1>

  <GroupHeader lang={lang} group={group} accessory />

  <div id="collapse-accessory" class="collapse">
    <h3 class="padding-bottom">{t(lang, "Metallhandsägebügel")}</h3>

    {blades.filter((blade) => blade.accessory).map((blade) => (
      <div class="blade-row">
        <BladeImage lang={lang} image={tr(blade.image, lang)} alias="blade_image_250h" alt={blade.quality} />
        <div class="spec-line">
          <img src="/static/img/other/shark_small_45w.png" alt="">
          <span>{blade.quality} <span class="text-orange-bold">{blade.type}</span></span>
        </div>
        <div class="spec-line">
          <img src="/static/img/other/tool_small_45w.png" alt="">
          <div set:html={markdown(tr(blade.description, lang))} />
        </div>
      </div>
    ))}
  </div>

  {rows.map(({ blade, i, subcategory }, j) => {
    const next = blades[i + 1];
    const inds = indicatorsOf(blade);
    return (
      <>
        {subcategoryChanged[j] && <h3 class={i === 0 ? "padding-bottom" : "padding-bottom padding-top-2"}>{subcategory}</h3>}
        <div class="blade-row">
          <BladeImage lang={lang} image={tr(blade.image, lang)} alias="blade_image_250h" alt={blade.quality} />

          <div class="row">
            <div class="col-md-6">
              <div class="spec-line">
                <img src="/static/img/other/shark_small_45w.png" alt="">
                <span>
                  {blade.quality} <span class="text-orange-bold">{blade.type}</span>
                  {next?.type === "ASM" && (
                    <><br>{next.quality} <span class="text-orange-bold">{next.type}</span></>
                  )}
                </span>
              </div>
              <div class="spec-line">
                <img src="/static/img/other/tool_small_45w.png" alt="">
                <div set:html={markdown(tr(blade.description, lang))} />
              </div>
            </div>
            <div class="col-md-6">
              <div class="table-responsive">
            <table class="table table-condensed table-striped-column table-hover">
              <thead>
              <tr>
              <th>
                {t(lang, "Bestell-Nr.")}
              </th>
              <th>
                {t(lang, "Verzahnung")}
              </th>
              <th>
                {t(lang, "Abmessung")}
              </th>
              <th>
                {t(lang, "Schnittbereich Metall")}
              </th>
              </tr>
              </thead>
              <tbody>
              <tr>
                {inds.map((ind) => (
                  <td class="text-orange-bold">
                    {blade.type}{ind.value}
                  </td>
                ))}
                <td>
                  {tr(blade.toothing, lang)} {t(lang, "ZpZ")}
                </td>
                <td>
                  {inds.map((ind) => (
                    <>{ind.length} x {ind.width} x {float(lang, ind.strength)} {t(lang, "mm")} </>
                  ))}
                </td>
                <td>
                  {blade.cutting_metal} {t(lang, "mm")}
                </td>
              </tr>
              </tbody>
            </table>
              </div>
            </div>
          </div>
        </div>
      </>
    );
  })}
</Base>
