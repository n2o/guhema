---
// Renders nothing when the file is missing (Django's thumbnail_url returned "" then).
import { thumbnail, type Alias } from '../lib/media';

interface Props {
  path: string | null | undefined;
  alias: Alias;
  alt: string;
  class?: string;
  /** Link target (a page, not a bigger version of the image). */
  href?: string;
}
const { path, alias, alt, class: cls = 'img-responsive', href } = Astro.props;
const img = await thumbnail(path, alias);
const Link = href ? 'a' : Fragment;
---
{img && (
  <Link href={href}><img class={cls} src={img.src} srcset={img.srcset} width={img.width} height={img.height} alt={alt} loading="lazy" decoding="async"></Link>
)}
