---
// Blade image thumbnail; renders nothing when the image is missing.
import Thumb from '../Thumb.astro';
import { media, type Alias } from '../../lib/media';
import { t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  /** Media path, already resolved for the language (tr()). */
  image: string | null | undefined;
  alias?: Alias;
  alt?: string | null;
  /** Link to a page (e.g. the band saw details); no link by default. */
  href?: string;
  /** Class of a wrapping div, only rendered when there is an image. */
  wrap?: string;
}
const { lang, image, alias = 'blade_image', alt, href, wrap } = Astro.props;
const exists = !!media(image);
const Wrap = wrap ? 'div' : Fragment;
---
{exists && (
  <Wrap class={wrap}>
    <div class="padding-bottom padding-top blade-img">
      <Thumb path={image} alias={alias} alt={alt || t(lang, 'Sägeblatt')} href={href} />
    </div>
  </Wrap>
)}
