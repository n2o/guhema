---
// Header of a product group page: image, description, recommendations/accessory buttons
import Thumb from '../Thumb.astro';
import type { ProductGroup } from '../../lib/data';
import { hasPage } from '../../lib/routes';
import { t, tr, url, type Lang } from '../../lib/i18n';
import { markdown } from '../../lib/markdown';

interface Props {
  lang: Lang;
  group: ProductGroup;
  /** Toggle button for the #collapse-accessory block. */
  accessory?: boolean;
}
const { lang, group, accessory } = Astro.props;
const advice = hasPage(group, 'Advices');
const name = tr(group.name, lang) ?? '';
---
<div class="row group-header">
  <div class="col-sm-3">
    <Thumb path={group.image} alias="products_teaserimage" alt={name} />
  </div>
  <div class="col-sm-9 group-header-text">
    <div class="markdown" set:html={markdown(tr(group.description, lang))} />
    {advice && (
      <a class="btn btn-primary" role="button" href={url(lang, `/produkte/${group.slug}/empfehlungen/`)}>
        {t(lang, 'Zu unseren Empfehlungen')}
      </a>
    )}
    {accessory && (
      <a class="btn btn-primary" role="button" data-toggle="collapse" href="#collapse-accessory"
         aria-expanded="false" aria-controls="collapse-accessory">
        {t(lang, 'Zubehörartikel anzeigen')}
        <span class="caret"></span>
      </a>
    )}
  </div>
</div>
