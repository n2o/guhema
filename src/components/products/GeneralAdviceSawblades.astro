---
// Materials, grades and tooth forms of machine and jigsaw blades
import ImageMultilang from './ImageMultilang.astro';
import { t, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
  /** Hide the "Die Wahl der richtigen Zahnform" section. */
  noToothforms?: boolean;
}
const { lang, noToothforms } = Astro.props;
---
<div>
  <h2 class="h3">{t(lang, "Material, Qualitäten und Einsatzbereiche")}</h2>
  <p>
    {t(lang, "Unser Streben nach perfekter Sägequalität beginnt schon bei der Auswahl unseres Vormaterials, denn dies ist die Ausgangsbasis für unsere Spitzenprodukte – nichts geht durch unsere Eingangskontrolle, was nicht die Note „Sehr gut“ verdient.")}
  </p>
  <p>
    {t(lang, "Erstklassiges Rohmaterial ist bei GUHEMA die Basis für präzises, schnelles und wirtschaftliches Sägen mit")}
  </p>
  <ul>
    <li>{t(lang, "hohen Stand- und kurzen Schnittzeiten")}</li>
    <li>{t(lang, "langer Lebensdauer")}</li>
    <li>{t(lang, "optimaler Schonung Ihrer Sägemaschine")}</li>
  </ul>
  <p>
    {t(lang, "Für die unterschiedlichsten Einsatzbereiche führen wir die passenden Qualitäten")}
  </p>

  <div class="well">
    <div class="spec-line"><img src="/static/img/other/shark_small_45w.png" alt="">
        <span>GUHEMA Super-HSS</span>
      </div>
    <div class="spec-line"><img src="/static/img/other/blade_small_45w.png" alt="">
        <span>{t(lang, "DMo 5 Qualität (Werkstoff-Nr. %(num)s)", { num: "1.3343" })}</span>
      </div>
    <div class="spec-line"><img src="/static/img/other/tool_small_45w.png" alt="">
        <span><Fragment set:html={t(lang, "Für Werkstoffe bis zu einer Zugfestigkeit von 1100 N/mm<sup>2</sup>")} /></span>
      </div>

    <div class="padding-top-05">
      <div class="spec-line"><img src="/static/img/other/shark_small_45w.png" alt="">
        <span>GUHEMA Brillant</span>
      </div>
      <div class="spec-line"><img src="/static/img/other/blade_small_45w.png" alt="">
        <span>{t(lang, "EMo 5 Co 5 Qualität (Werkstoff-Nr. %(num)s)", { num: "1.3243" })}</span>
      </div>
      <div class="spec-line"><img src="/static/img/other/tool_small_45w.png" alt="">
        <span><Fragment set:html={t(lang, "Für extrem harte Werkstoffe bis 1300 N/mm<sup>2</sup>, z.B. austenitische Stähle und Stähle mit hohem Chrom-Nickel-Gehalt")} /></span>
      </div>
    </div>

    <div class="padding-top-05">
      <div class="spec-line"><img src="/static/img/other/shark_small_45w.png" alt="">
        <span>GUHEMA Bi-lastic</span>
      </div>
      <div class="spec-line"><img src="/static/img/other/blade_small_45w.png" alt="">
        <span>{t(lang, "DMo 5 Schneidenqualität (Werkstoff-Nr. %(num)s) auf einem Sonderstahlrücken", { num: "1.3343" })}</span>
      </div>
      <div class="spec-line"><img src="/static/img/other/tool_small_45w.png" alt="">
        <span><Fragment set:html={t(lang, "Für Werkstoffe bis zu einer Zugfestigkeit von 1100 N/mm<sup>2</sup>")} /></span>
      </div>
    </div>
  </div>

  {!noToothforms && (<>
  <h2 class="h3">{t(lang, "Die Wahl der richtigen Zahnform")}</h2>
  <p>
    {t(lang, "Unsere GUHEMA-Maschinensägeblätter haben erst durch die richtige Zahnform den optimalen Biss. Wir liefern:")}
  </p>

  <div class="row">
    <div class="col-md-6 padding-top-3">
      <span class="bg-orange-dark padding-lr-1 text-bold">
        {t(lang, "Normalzahn")}
      </span>
      <p>
        {t(lang, "Für den allgemeinen, universellen Einsatz")}
      </p>
    </div>
    <div class="col-md-6 text-right">
      <ImageMultilang lang={lang} prefix="img/produktbilder/maschinensaegeblaetter/katalog_2014/normalverzahnung_" extension=".png" alt={t(lang, "Normalzahn")} width="400" nothumbnail />
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 padding-top-3">
      <span class="bg-orange-medium padding-lr-1 text-bold">
        {t(lang, "Positivzahn")}
      </span>
      <p>
        {t(lang, "Der austenitische, zähharte Stähle trennt")}
      </p>
    </div>
    <div class="col-md-6 text-right">
      <ImageMultilang lang={lang} prefix="img/produktbilder/maschinensaegeblaetter/katalog_2014/positivverzahnung_" extension=".png" alt={t(lang, "Positivzahn")} width="400" nothumbnail />
    </div>
  </div>

  <div class="row">
    <div class="col-md-6 padding-top-3">
      <span class="bg-orange-light padding-lr-1 text-bold">
        {t(lang, "Variable Positivverzahnung")}
      </span>
      <p>
        {t(lang, "GUHEMA FUTURE, die keine Wünsche an ein Maschinensägeblatt mehr offen lässt")}
      </p>
    </div>
    <div class="col-md-6 text-right">
      <ImageMultilang lang={lang} prefix="img/produktbilder/maschinensaegeblaetter/katalog_2014/variable_positivverzahnung_" extension=".png" alt={t(lang, "Variable Positivverzahnung")} width="400" nothumbnail />
    </div>
  </div>
  </>)}
</div>
