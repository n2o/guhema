# Apache config for the static site on Strato (replaces the old nginx proxy).
Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

RewriteEngine On
# Sections of the old Django site that no longer exist (absolute target: one hop from any host/scheme)
RewriteRule ^(news|messen|i18n|pages)(/.*)?$ https://guhema.com/ [R=301,L]
# One canonical host (duplicate content otherwise): keep in sync with `site` in astro.config.mjs.
# HTTP → HTTPS is forced in the Strato panel (SSL settings), before these rules run.
RewriteCond %{HTTP_HOST} !^guhema\.com(:\d+)?$ [NC]
RewriteRule ^ https://guhema.com%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  # High-resolution print catalogues duplicate the web PDFs: keep them out of search results
  <FilesMatch "_print\.pdf$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>
  # Hashed build assets never change
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/static/#">
    Header set Cache-Control "public, max-age=604800"
  </ElseIf>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml text/javascript application/javascript application/json image/svg+xml
</IfModule>
